<?xml version="1.0"?>
<package format="2">
  <name>tiago_ring_controller</name>
  <version>0.0.1</version>
  <description>Spiking ring-attractor research controllers, calibration, analysis, and TIAGo simulation interfaces.</description>

  <maintainer email="user@example.com">Workspace User</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>play_motion_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>pal_gazebo_worlds</exec_depend>
  <exec_depend>python3-colorcet</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>tiago_gazebo</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosunit</test_depend>
</package>
