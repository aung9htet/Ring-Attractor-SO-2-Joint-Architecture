/.runtime/
# Bytecode is never tracked, except the historical Python 3.8 caches recovered
# from the image, which moved with the frozen scripts into legacy/.
__pycache__/
*.py[cod]
!src/tiago_ring_controller/legacy/__pycache__/
!src/tiago_ring_controller/legacy/builders/__pycache__/
!src/tiago_ring_controller/legacy/builders/single_joint/__pycache__/
!src/tiago_ring_controller/legacy/helpers/__pycache__/
!src/tiago_ring_controller/legacy/trainer/__pycache__/

# Generated results (branch blocks-refactor onwards; main and the tag
# legacy-loop-baseline keep every file).  Scientific inputs under
# src/tiago_ring_controller/src/config/ stay tracked.
src/tiago_ring_controller/outputs/
src/tiago_ring_controller/results/
src/tiago_ring_controller/src/outputs/
src/tiago_ring_controller/experiment_results/torque_data/*.csv
src/tiago_ring_controller/experiment_results/recorded_video/
recovered/experiment_results/recorded_video/
src/tiago_ring_controller/src/collected_data/
src/tiago_ring_controller/src/plots/
src/tiago_ring_controller/src/results_plots/
# Working-directory-relative outputs of the frozen scripts run from legacy/
src/tiago_ring_controller/legacy/outputs/
src/tiago_ring_controller/legacy/collected_data/
src/tiago_ring_controller/legacy/plots/
src/tiago_ring_controller/legacy/results_plots/
src/tiago_ring_controller/legacy/figures/
# NEST crash backtraces and monitor frame dumps
*.btr
frames/
